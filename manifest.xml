        xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
        xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
        xsi:type="TaskPaneApp">

  <!--
    Title Capitalizer - an Office Add-in that title-cases the active
    selection in Word, Excel, or PowerPoint using AP, APA, Chicago, MLA,
    NY Times, Wikipedia, Bluebook, or AMA style. The same add-in runs in
    Office on Windows, Mac, the Web, and iPad.

    The Id below identifies this add-in to Office. Replace it if you
    publish your own fork.
  -->
  <Id>9b3d2c40-7d8a-4b2e-9b1d-1f6a2c4d8e10</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>socrtwo</ProviderName>
  <DefaultLocale>en-US</DefaultLocale>
  <DisplayName DefaultValue="Title Capitalizer" />
  <Description DefaultValue="Capitalize titles in Word, Excel, and PowerPoint using AP, APA, Chicago, MLA, NY Times, Wikipedia, Bluebook, or AMA style." />
  <IconUrl DefaultValue="https://socrtwo.github.io/Title-Capitalizer/assets/icon-32.png" />
  <HighResolutionIconUrl DefaultValue="https://socrtwo.github.io/Title-Capitalizer/assets/icon-80.png" />
  <SupportUrl DefaultValue="https://github.com/socrtwo/Title-Capitalizer" />

  <!-- Domains the add-in is allowed to navigate to inside its iframe. -->
  <AppDomains>
    <AppDomain>https://socrtwo.github.io</AppDomain>
  </AppDomains>

  <!-- Supported Office hosts. -->
  <Hosts>
    <Host Name="Document" />
    <Host Name="Workbook" />
    <Host Name="Presentation" />
  </Hosts>

  <DefaultSettings>
    <SourceLocation DefaultValue="https://socrtwo.github.io/Title-Capitalizer/src/taskpane/taskpane.html" />
  </DefaultSettings>

  <Permissions>ReadWriteDocument</Permissions>

  <!--
    VersionOverrides upgrade the add-in to the richer add-in command
    model: ribbon buttons, function commands, etc. Each host gets its
    own customization block under VersionOverridesV1_1.
  -->
